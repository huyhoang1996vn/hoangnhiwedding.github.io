FROM nginx:alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY index.html /var/www/hoangnhiwedding/index.html
COPY favicon.ico /var/www/hoangnhiwedding/favicon.ico
COPY apple-touch-icon.png /var/www/hoangnhiwedding/apple-touch-icon.png
COPY css /var/www/hoangnhiwedding/css
COPY js /var/www/hoangnhiwedding/js
COPY guests /var/www/hoangnhiwedding/guests
COPY assets /var/www/hoangnhiwedding/assets
